<Window x:Class="HaloVolt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="HaloVolt 环电"
        Width="1180" Height="790"
        MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Assets/app.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource AppFontFamily}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Border x:Name="WindowFrame" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <!-- Soft brand glows, purely decorative and non-interactive. -->
            <Canvas IsHitTestVisible="False" ClipToBounds="True" Opacity="0.65">
                <Ellipse Width="560" Height="560" Canvas.Right="-190" Canvas.Top="-260">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#244CC2FF" Offset="0" />
                            <GradientStop Color="#004CC2FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="500" Height="500" Canvas.Left="-220" Canvas.Bottom="-300">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#16FFB84D" Offset="0" />
                            <GradientStop Color="#00FFB84D" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Grid Grid.Row="0" x:Name="TitleBar">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/mark.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="HaloVolt" Margin="9,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="环电" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <Border Style="{DynamicResource ChipStyle}" Margin="16,0,0,0" Padding="9,3" Background="{DynamicResource AccentSoftBrush}" BorderThickness="0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding MonitoringPill}" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Style="{DynamicResource CaptionButtonStyle}" Click="MinimizeButton_Click" ToolTip="最小化"
                                AutomationProperties.Name="最小化">
                            <TextBlock Text="&#xE921;" FontFamily="{DynamicResource SymbolFontFamily}" FontSize="10" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{DynamicResource CaptionButtonStyle}" Click="MaximizeButton_Click" ToolTip="最大化"
                                AutomationProperties.Name="最大化或还原">
                            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{DynamicResource SymbolFontFamily}" FontSize="10" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{DynamicResource CloseCaptionButtonStyle}" Click="CloseButton_Click" ToolTip="关闭"
                                AutomationProperties.Name="关闭">
                            <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource SymbolFontFamily}" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="232" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                        <Grid Margin="0,6,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="设置" Margin="22,9,0,7" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />

                            <ListBox x:Name="NavList" Grid.Row="0" Margin="0,30,0,0" Style="{DynamicResource NavListBoxStyle}"
                                     SelectionChanged="NavList_SelectionChanged">
                                <ListBoxItem Tag="Overview">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE80F;" Style="{DynamicResource NavGlyphStyle}" />
                                        <TextBlock Grid.Column="1" Text="概览" Style="{DynamicResource NavLabelStyle}" />
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem Tag="Devices">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7F4;" Style="{DynamicResource NavGlyphStyle}" />
                                        <TextBlock Grid.Column="1" Text="设备与电量" Style="{DynamicResource NavLabelStyle}" />
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem Tag="Alerts">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7E7;" Style="{DynamicResource NavGlyphStyle}" />
                                        <TextBlock Grid.Column="1" Text="低电量提醒" Style="{DynamicResource NavLabelStyle}" />
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem Tag="Tray">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xEA3A;" Style="{DynamicResource NavGlyphStyle}" />
                                        <TextBlock Grid.Column="1" Text="托盘圆环" Style="{DynamicResource NavLabelStyle}" />
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem Tag="General">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE713;" Style="{DynamicResource NavGlyphStyle}" />
                                        <TextBlock Grid.Column="1" Text="通用" Style="{DynamicResource NavLabelStyle}" />
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem Tag="Diagnostics">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7B8;" Style="{DynamicResource NavGlyphStyle}" />
                                        <TextBlock Grid.Column="1" Text="调试与诊断" Style="{DynamicResource NavLabelStyle}" />
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem Tag="About">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE946;" Style="{DynamicResource NavGlyphStyle}" />
                                        <TextBlock Grid.Column="1" Text="关于" Style="{DynamicResource NavLabelStyle}" />
                                    </Grid>
                                </ListBoxItem>
                            </ListBox>

                            <Border Grid.Row="2" Style="{DynamicResource InnerCardStyle}" Margin="12,10,12,0" Padding="14">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEA18;" FontFamily="{DynamicResource SymbolFontFamily}" FontSize="15" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="省电守护" Margin="7,0,0,0" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      IsChecked="{Binding Settings.NotificationsEnabled, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Settings.MonitoringStatusText}" Style="{DynamicResource MicroTextStyle}" Margin="0,7,0,0" />
                                    <TextBlock Text="只在设备活动时读取，绝不轮询唤醒" Style="{DynamicResource MicroTextStyle}" Margin="0,2,0,0" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <Button Content="暂停监控 30 分钟" Style="{DynamicResource LinkButtonStyle}" Margin="0,9,0,0" FontSize="11.5"
                                            Command="{Binding Pause30Command}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Page host -->
                    <Grid Grid.Column="1">
                        <ContentControl x:Name="PageHost" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
