<UserControl x:Class="HaloVolt.Views.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,24,36,32" MaxWidth="1180">
            <StackPanel>
                <TextBlock Text="通用" Style="{DynamicResource PageTitleStyle}" />
                <TextBlock Text="启动方式、外观、读取策略与诊断工具。" Style="{DynamicResource PageSubtitleStyle}" Margin="0,5,0,0" />
            </StackPanel>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="启动与关闭" Style="{DynamicResource SectionTitleStyle}" />

                            <Grid Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="开机自动启动" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="写入当前用户的 Windows 启动项，无需管理员权限。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.AutoStart, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="启动时" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="静默启动只显示托盘图标，不弹出窗口。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="190" Style="{DynamicResource ComboBoxStyle}" VerticalAlignment="Center"
                                          ItemsSource="{Binding StartupModeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.StartupMode, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="点击关闭按钮时" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="建议保留在托盘，以便继续监控电量。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="160" Style="{DynamicResource ComboBoxStyle}" VerticalAlignment="Center"
                                          ItemsSource="{Binding CloseActionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.CloseAction, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="最小化时隐藏到托盘" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="关闭后释放设置窗口占用的界面内存，只保留轻量后台。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.MinimizeToTray, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,18,0,0">
                                <StackPanel Margin="0,0,64,0">
                                    <TextBlock Text="缩到托盘时提示一次" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="每次通过关闭或最小化隐藏到托盘时，用托盘气泡提醒程序仍在运行。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.ShowTrayHintOnMinimize, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="外观" Style="{DynamicResource SectionTitleStyle}" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="主题" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="跟随系统会实时响应 Windows 浅色 / 深色模式。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="130" Style="{DynamicResource ComboBoxStyle}" VerticalAlignment="Center"
                                          ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.Theme, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="减少动画" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="关闭页面切换淡入动画，适合远程桌面或低性能设备。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.ReduceMotion, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="电量读取策略" Style="{DynamicResource SectionTitleStyle}" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="自动读取间隔" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="仅在用户活动时按此间隔检查；空闲时完全静默。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="140" Style="{DynamicResource ComboBoxStyle}" VerticalAlignment="Center"
                                          ItemsSource="{Binding RefreshIntervalOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.SafeRefreshMinutes, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="允许在设备活动时主动读取" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="关闭后只使用 Windows 缓存和系统电池信息，最省电但外设电量可能滞后。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.ActiveReadWhenInUse, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="显示笔记本电量" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="在概览、设备列表和托盘中心圆点中显示内置电池。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.ShowSystemBattery, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,18,0,0">
                                <StackPanel Margin="0,0,64,0">
                                    <TextBlock Text="隐藏不支持读取的设备" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="默认隐藏没有电量通道的键鼠；原始 HID 通道仍可在调试与诊断中查看。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.HideUnsupportedDevices, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="设备协议" Style="{DynamicResource SectionTitleStyle}" />
                            <TextBlock Text="关闭不使用的协议可减少扫描开销。修改后建议重新扫描。" Style="{DynamicResource SettingDescriptionStyle}" />
                            <Grid Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="蓝牙 LE 电池服务" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="读取 0x180F 标准 Battery Service，优先使用 Windows 缓存。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.EnableBleProvider, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,15,0,0">
                                <StackPanel>
                                    <TextBlock Text="Logitech HID++" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="支持直连与 Unifying / Bolt 类接收器，按设备通道显示。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.EnableLogitechProvider, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,15,0,0">
                                <StackPanel Margin="0,0,64,0">
                                    <TextBlock Text="标准 HID 电量特性" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="Generic Device Controls 的 Battery Strength 特性。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.EnableHidBatteryProvider, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,15,0,0">
                                <StackPanel Margin="0,0,64,0">
                                    <TextBlock Text="DAREU EK75 支持" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="优先读取官方 DAREU Driver；驱动未运行时直接查询 EK75 的 HID 电量命令。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.EnableDareuDriverBridge, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,15,0,0">
                                <StackPanel Margin="0,0,64,0">
                                    <TextBlock Text="演示模式" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="用模拟的 MX Master 3S / MX Keys S 演示界面与通知，不读取真实设备。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.DemoMode, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="暂停与恢复" Style="{DynamicResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding Settings.MonitoringStatusText}" Style="{DynamicResource CaptionTextStyle}" Margin="0,7,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                <Button Content="暂停 30 分钟" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding Pause30Command}" />
                                <Button Content="暂停 1 小时" Style="{DynamicResource SecondaryButtonStyle}" Margin="8,0,0,0" Command="{Binding Pause60Command}" />
                                <Button Content="恢复" Style="{DynamicResource PrimaryButtonStyle}" Margin="8,0,0,0" Command="{Binding ResumeMonitoringCommand}" />
                            </StackPanel>
                            <TextBlock Text="暂停期间不读取外设、不发送低电量通知；托盘图标保留最后一次数据。"
                                       Style="{DynamicResource MicroTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="数据与诊断" Style="{DynamicResource SectionTitleStyle}" />
                            <TextBlock Text="设置以 JSON 保存在当前用户目录，不上传任何数据。" Style="{DynamicResource MicroTextStyle}" Margin="0,5,0,0" />
                            <Button Content="打开数据文件夹" Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,13,0,0" Command="{Binding OpenDataFolderCommand}" />
                            <Button Content="查看运行日志" Style="{DynamicResource SubtleButtonStyle}" HorizontalAlignment="Stretch" Margin="0,6,0,0" Command="{Binding OpenLogCommand}" />
                            <Button Content="复制诊断信息" Style="{DynamicResource SubtleButtonStyle}" HorizontalAlignment="Stretch" Margin="0,2,0,0" Command="{Binding CopyDiagnosticReportCommand}" />
                            <Border Style="{DynamicResource ThinSeparatorStyle}" Margin="0,12,0,6" />
                            <Button Content="恢复默认设置" Style="{DynamicResource DangerButtonStyle}" HorizontalAlignment="Stretch" Command="{Binding ResetSettingsCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="14,12" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource SymbolFontFamily}" FontSize="14" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Top" Margin="0,1,8,0" />
                            <TextBlock Text="HaloVolt 不做遥测、不联网、不安装驱动。所有设备访问都通过 Windows 自带 HID / 蓝牙接口完成。"
                                       Style="{DynamicResource MicroTextStyle}" TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>
                    </Border>

                    <Button Content="退出 HaloVolt" Style="{DynamicResource SubtleButtonStyle}" HorizontalAlignment="Right" Margin="0,12,0,0" Command="{Binding ExitApplicationCommand}" Foreground="{DynamicResource DangerBrush}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
