<Window x:Class="HaloVolt.Views.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:HaloVolt.Controls"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Width="322"
        SizeToContent="Height"
        FontFamily="{DynamicResource AppFontFamily}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="TrayMenuItemButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10" CornerRadius="12" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.32" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="0,10,0,8">
            <!-- Header -->
            <Grid Margin="16,2,16,10">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="HaloVolt" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="环电" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="5,2,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding MonitoringPill}" FontSize="10.5" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding LastSyncText}" Style="{DynamicResource MicroTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- Battery summary -->
            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Margin="12,0,12,8" Padding="12,9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{Binding MouseAccentBrush}" VerticalAlignment="Center" Margin="1,0,8,0" />
                    <TextBlock Grid.Column="1" Text="鼠标" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding MousePercentText}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding MouseName}" Style="{DynamicResource MicroTextStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding MouseSubtitle}" Style="{DynamicResource MicroTextStyle}" HorizontalAlignment="Right" />

                    <Ellipse Grid.Row="4" Grid.Column="0" Width="8" Height="8" Fill="{Binding KeyboardAccentBrush}" VerticalAlignment="Center" Margin="1,0,8,0" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="键盘" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding KeyboardPercentText}" FontWeight="SemiBold" FontSize="12" />

                    <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Visibility="{Binding HasSystemBattery, Converter={StaticResource BoolToVisibility}}">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="1,0,8,0" />
                        <TextBlock Text="笔记本" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SystemPercentText}" FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SystemSubtitle}" Style="{DynamicResource MicroTextStyle}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="{Binding TrayTooltip}" Style="{DynamicResource MicroTextStyle}" Margin="18,0,18,6" TextTrimming="CharacterEllipsis" />

            <Border Style="{DynamicResource ThinSeparatorStyle}" Margin="12,2,12,4" />

            <Button Style="{DynamicResource TrayMenuItemButton}" Click="OpenSettings_Click" AutomationProperties.Name="打开设置">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE713;" FontFamily="{DynamicResource SymbolFontFamily}" FontSize="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="打开设置" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="&#xE72A;" FontFamily="{DynamicResource SymbolFontFamily}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Style="{DynamicResource TrayMenuItemButton}" Click="Refresh_Click" AutomationProperties.Name="立即安全刷新">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource SymbolFontFamily}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="立即安全刷新" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Style="{DynamicResource TrayMenuItemButton}" Click="Pause30_Click" AutomationProperties.Name="暂停监控 30 分钟"
                    Visibility="{Binding IsMonitoringPaused, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE769;" FontFamily="{DynamicResource SymbolFontFamily}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="暂停监控 30 分钟" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Button Style="{DynamicResource TrayMenuItemButton}" Click="Resume_Click" AutomationProperties.Name="恢复监控"
                    Visibility="{Binding IsMonitoringPaused, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE768;" FontFamily="{DynamicResource SymbolFontFamily}" FontSize="14" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="恢复监控" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Border Style="{DynamicResource ThinSeparatorStyle}" Margin="12,4" />

            <Grid Margin="12,2,12,2" Height="38">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7F4;" FontFamily="{DynamicResource SymbolFontFamily}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Width="26" VerticalAlignment="Center" />
                    <TextBlock Text="电量圆环图标" VerticalAlignment="Center" />
                </StackPanel>
                <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsChecked="{Binding Settings.TrayBatteryIconEnabled, Mode=TwoWay}" AutomationProperties.Name="显示电量圆环图标" />
            </Grid>

            <Grid Margin="12,0,12,2" Height="38">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7B8;" FontFamily="{DynamicResource SymbolFontFamily}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Width="26" VerticalAlignment="Center" />
                    <TextBlock Text="调试模式" VerticalAlignment="Center" />
                </StackPanel>
                <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsChecked="{Binding Settings.DebugMode, Mode=TwoWay}" AutomationProperties.Name="调试模式" />
            </Grid>

            <Border Style="{DynamicResource ThinSeparatorStyle}" Margin="12,4" />

            <Button Style="{DynamicResource TrayMenuItemButton}" Click="Exit_Click" Foreground="{DynamicResource DangerBrush}" AutomationProperties.Name="退出 HaloVolt">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7E8;" FontFamily="{DynamicResource SymbolFontFamily}" FontSize="14" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="退出 HaloVolt" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</Window>
