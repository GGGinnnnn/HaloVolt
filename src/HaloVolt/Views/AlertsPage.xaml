<UserControl x:Class="HaloVolt.Views.AlertsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,24,36,32" MaxWidth="1180">
            <Grid>
                <StackPanel>
                    <TextBlock Text="低电量提醒" Style="{DynamicResource PageTitleStyle}" />
                    <TextBlock Text="通过 Windows 通知提醒你及时充电，并可设置多次提醒，避免漏看。" Style="{DynamicResource PageSubtitleStyle}" Margin="0,5,0,0" />
                </StackPanel>
                <Border Style="{DynamicResource ChipStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource AccentSoftBrush}" BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding NotificationStatusText}" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.28*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="启用低电量通知" Style="{DynamicResource SectionTitleStyle}" />
                                    <TextBlock Text="关闭后仍会读取电量并显示圆环，但不会弹出通知。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.NotificationsEnabled, Mode=TwoWay}" />
                            </Grid>

                            <Border Style="{DynamicResource ThinSeparatorStyle}" Margin="0,17,0,4" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="低电量阈值" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="电量首次低于此值时立即提醒。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{DynamicResource ChipStyle}" Background="{DynamicResource AccentSoftBrush}" BorderThickness="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Settings.LowThreshold, StringFormat={}{0}%}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </Grid>
                            <Slider Style="{DynamicResource SliderStyle}" Minimum="5" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.LowThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                            <Grid>
                                <TextBlock Text="5%" Style="{DynamicResource MicroTextStyle}" />
                                <TextBlock Text="50%" Style="{DynamicResource MicroTextStyle}" HorizontalAlignment="Right" />
                            </Grid>

                            <Border Style="{DynamicResource ThinSeparatorStyle}" Margin="0,20,0,4" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,64,0">
                                    <TextBlock Text="再次提醒的电量步进" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="低于阈值后，每再下降多少电量提醒一次。例如 20% 提醒后，每降 5% 再提醒。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{DynamicResource ChipStyle}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Settings.RepeatStep, StringFormat=每 {0}%}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <Slider Style="{DynamicResource SliderStyle}" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.RepeatStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                            <Grid>
                                <TextBlock Text="1%" Style="{DynamicResource MicroTextStyle}" />
                                <TextBlock Text="20%" Style="{DynamicResource MicroTextStyle}" HorizontalAlignment="Right" />
                            </Grid>

                            <Border Style="{DynamicResource ThinSeparatorStyle}" Margin="0,20,0,4" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,64,0">
                                    <TextBlock Text="重复提醒冷却时间" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="避免短时间内连续弹窗；达到步进且超过冷却时间才会再次提醒。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{DynamicResource ChipStyle}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Settings.RepeatCooldownMinutes, StringFormat={}{0} 分钟}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <Slider Style="{DynamicResource SliderStyle}" Minimum="5" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.RepeatCooldownMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                            <Grid>
                                <TextBlock Text="5 分钟" Style="{DynamicResource MicroTextStyle}" />
                                <TextBlock Text="120 分钟" Style="{DynamicResource MicroTextStyle}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="紧急与系统提醒" Style="{DynamicResource SectionTitleStyle}" />
                            <Grid Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="紧急低电量提醒" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="在极低电量时额外发送一次语气更强的通知。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.CriticalEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,14,0,0" IsEnabled="{Binding Settings.CriticalEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="紧急阈值" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="仅当未充电时触发。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{DynamicResource ChipStyle}" Background="{DynamicResource DangerSoftBrush}" BorderThickness="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Settings.CriticalThreshold, StringFormat={}{0}%}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                                </Border>
                            </Grid>
                            <Slider Style="{DynamicResource SliderStyle}" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.CriticalThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                                    IsEnabled="{Binding Settings.CriticalEnabled}" />

                            <Border Style="{DynamicResource ThinSeparatorStyle}" Margin="0,18,0,4" />

                            <Grid Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="笔记本电池提醒" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="内置电池低于阈值时也发送 Windows 通知。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.NotifySystemBattery, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,12,0,0" IsEnabled="{Binding Settings.NotifySystemBattery}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <Slider Style="{DynamicResource SliderStyle}" Minimum="5" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding Settings.SystemLowThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1" Text="{Binding Settings.SystemLowThreshold, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>

                            <Border Style="{DynamicResource ThinSeparatorStyle}" Margin="0,16,0,4" />

                            <Grid Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="通知提示音" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="跟随 Windows 默认通知音效。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.SoundEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="断连提醒" Style="{DynamicResource SettingTitleStyle}" />
                                    <TextBlock Text="设备休眠或离开范围时提示一次，默认关闭以免夜间打扰。" Style="{DynamicResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding Settings.NotifyOnDisconnect, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right column: preview & history -->
                <StackPanel Grid.Column="2">
                    <Border Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="通知预览" Style="{DynamicResource SectionTitleStyle}" />
                                <TextBlock Text="Windows 通知中心" Style="{DynamicResource MicroTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="pack://application:,,,/Assets/mark.png" Width="26" Height="26" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="HaloVolt 环电" Style="{DynamicResource MicroTextStyle}" />
                                        <TextBlock Text="鼠标电量偏低" FontWeight="SemiBold" FontSize="13" Margin="0,3,0,0" />
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" LineHeight="18">
                                            <Run Text="{Binding MouseName, Mode=OneWay}" />
                                            <Run Text=" 剩余 " />
                                            <Run Text="{Binding Settings.LowThreshold, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="%，建议尽快充电。下次将在约 " />
                                            <Run Text="{Binding PreviewNextThreshold, Mode=OneWay}" />
                                            <Run Text="% 时再次提醒。" />
                                        </TextBlock>
                                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10,0,8" />
                                        <TextBlock Text="打开设置" Foreground="{DynamicResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="实际内容会按设备名称、类型和当前电量自动生成。若系统开启专注助手，通知可能只在通知中心静默出现。"
                                       Style="{DynamicResource MicroTextStyle}" Margin="0,10,0,0" LineHeight="17" />
                            <Button Content="发送测试通知" Style="{DynamicResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,14,0,0"
                                    Command="{Binding TestNotificationCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="提醒记录" Style="{DynamicResource SectionTitleStyle}" />
                                <Button Content="清除提醒记忆" Style="{DynamicResource LinkButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Command="{Binding ClearAlertMemoryCommand}" ToolTip="清除后会重新从当前电量开始判断" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding NotificationHistory}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource SymbolFontFamily}" FontSize="14"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" />
                                                    <TextBlock Text="{Binding Body}" Style="{DynamicResource MicroTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Time, StringFormat=HH:mm}" Style="{DynamicResource MicroTextStyle}" VerticalAlignment="Top" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Padding="14,22" Background="{DynamicResource InputBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Visibility="{Binding HasNotificationHistory, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="&#xE7E7;" FontFamily="{DynamicResource SymbolFontFamily}" FontSize="20" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="还没有提醒记录" Style="{DynamicResource MicroTextStyle}" HorizontalAlignment="Center" Margin="0,7,0,0" />
                                    <TextBlock Text="电量低于阈值后，通知会出现在这里。" Style="{DynamicResource MicroTextStyle}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="14,12" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="{DynamicResource SymbolFontFamily}" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,8,0" />
                            <TextBlock Text="通知通过 Windows 通知中心发送。若没有弹出，请检查「设置 → 系统 → 通知」中 HaloVolt 是否被允许，以及专注助手是否开启。"
                                       Style="{DynamicResource MicroTextStyle}" TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
